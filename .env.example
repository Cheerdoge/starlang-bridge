# 运行环境: dev / prod
APP_ENV=dev
APP_PORT=8080

# 情境配置数据文件
SCENARIO_FILE=config/scenarios.json

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=starlang_bridge
MYSQL_CHARSET=utf8mb4
MYSQL_LOG_LEVEL=warn
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME_MIN=60

# JWT
JWT_SECRET=please-change-me
JWT_ISSUER=starlang-bridge
JWT_TTL_HOURS=72

# 微信小程序
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 本地联调时置为 true，可不依赖微信服务器返回模拟 openid
WECHAT_MOCK=true

# AI 适配层
# provider 取 mock 或 deepseek；mock 不消耗额度、可离线跑通完整对话
AI_PROVIDER=mock
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
