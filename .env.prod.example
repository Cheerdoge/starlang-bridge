# ============================================================
# 生产部署环境变量模板（Docker Compose 专用）
# 使用：cp .env.prod.example .env.prod 后填写真实值
# 注意：.env.prod 含密钥，已被 .gitignore 忽略，切勿提交
# ============================================================

# 运行环境: dev / prod
APP_ENV=prod
APP_PORT=8080
# 情境配置数据文件（镜像内路径，勿改）
SCENARIO_FILE=config/scenarios.json
TZ=Asia/Shanghai

# ---- 反向代理域名（Caddy）----
# 有解析到本服务器的域名时填写，自动启用 HTTPS；无域名留空则走 HTTP :80
DOMAIN=

# ---- MySQL（由 compose 内置，主机名固定为 mysql）----
# 该值同时作为 MySQL root 密码，请改成强密码
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=starlang_bridge
MYSQL_USER=root
MYSQL_CHARSET=utf8mb4
MYSQL_LOG_LEVEL=warn
MYSQL_MAX_OPEN_CONNS=50
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME_MIN=60

# ---- JWT ----
# 生成方式: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ISSUER=starlang-bridge
JWT_TTL_HOURS=72

# ---- 微信小程序 ----
# 暂无备案域名时保持 WECHAT_MOCK=true 以便前端联调；
# 域名就绪后改为 false 并填写真实 AppID / AppSecret
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK=true

# ---- AI 适配层 ----
# provider: mock / deepseek
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
